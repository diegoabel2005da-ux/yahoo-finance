# Copie este archivo como «.env» (en esta misma carpeta) y complete los valores.
# El archivo .env NO se sube a GitHub.

# Supabase → botón «Connect» → «Session pooler». Reemplace [YOUR-PASSWORD] por la contraseña de la base.
# Si lo deja vacío, la plataforma usa una base local SQLite (plataforma.db) y carga sola los datos semilla.
DATABASE_URL=

# Esquema de PostgreSQL donde viven las tablas en Supabase (no cambiar).
DB_SCHEMA=plataforma

# Con Supabase los datos ya están cargados: 0 evita recargar los datos semilla en cada arranque.
# Con SQLite local déjelo en 1.
AUTO_SEED=0

# Opcional: token del SIE de Banxico (https://www.banxico.org.mx/SieAPIRest/) para «Actualizar todos los datos».
BANXICO_TOKEN=

# Opcional: llave de la API de Claude para la IA explicativa. Sin ella se usa el explicador por reglas.
ANTHROPIC_API_KEY=
